      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 Compare P[0..m-1] with T[i..i+m-1] for every window\n\u2022 Up to m character comparisons per window\n\u2022 Total comparisons: (n - m + 1) * m\n\u2022 Worst-case Time Complexity: O(n * m)",
      "originalText": "\u2022 Compare P[0..m-1] with T[i..i+m-1] for every window\n\u2022 Up to m character comparisons per window\n\u2022 Total comparisons: (n - m + 1) * m\n\u2022 Worst-case Time Complexity: O(n * m)",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "ch16-01-pattern-matching-naive-vs-rk-n2",
      "lineHeight": 1.25,
      "baseline": 14
    },
