      "link": null,
      "locked": false
    },
    {
      "id": "ch16-03-prefix-hash-window-extraction-t5",
      "type": "text",
      "x": 336,
      "y": 537.5,
      "width": 688,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1705,
      "version": 1,
      "versionNonce": 1706,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "C++ Modular Subtraction Safety Rule:\nwinHash = (hs[r] - hs[l-1] + MOD) % MOD\n(+ MOD prevents negative values resulting from % operator in C++)",
      "originalText": "C++ Modular Subtraction Safety Rule:\nwinHash = (hs[r] - hs[l-1] + MOD) % MOD\n(+ MOD prevents negative values resulting from % operator in C++)",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "ch16-03-prefix-hash-window-extraction-n5",
      "lineHeight": 1.25,
      "baseline": 14
    }
