      "locked": false
    },
    {
      "id": "ch16-03-prefix-hash-window-extraction-t2",
      "type": "text",
      "x": 746,
      "y": 180.0,
      "width": 468,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1702,
      "version": 1,
      "versionNonce": 1703,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "hs[l-1] = sum of val(T[k]) * P^k for k in 0..l-1\n(Cumulative weighted hash before window start l)",
      "originalText": "hs[l-1] = sum of val(T[k]) * P^k for k in 0..l-1\n(Cumulative weighted hash before window start l)",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "ch16-03-prefix-hash-window-extraction-n2",
      "lineHeight": 1.25,
      "baseline": 14
    },
    {
      "id": "ch16-03-prefix-hash-window-extraction-n3",
      "type": "rectangle",
      "x": 330,
      "y": 260,
      "width": 700,
      "height": 110,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "#e0d5fa",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 1503,
      "version": 1,
      "versionNonce": 1504,
      "isDeleted": false,
      "boundElements": [
        {
          "type": "text",
          "id": "ch16-03-prefix-hash-window-extraction-t3"
        }
      ],
      "updated": 1,
      "link": null,
      "locked": false
    },
    {
      "id": "ch16-03-prefix-hash-window-extraction-t3",
      "type": "text",
      "x": 336,
      "y": 305.0,
      "width": 688,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1703,
      "version": 1,
      "versionNonce": 1704,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Subtract to remove unwanted left prefix:\nwindow_raw = hs[r] - hs[l-1]   (if l > 0; else hs[r])\n= P^l * (T[l]*P^0 + T[l+1]*P^1 + ... + T[r]*P^(m-1))\n= P^l * (hash of the window)",
      "originalText": "Subtract to remove unwanted left prefix:\nwindow_raw = hs[r] - hs[l-1]   (if l > 0; else hs[r])\n= P^l * (T[l]*P^0 + T[l+1]*P^1 + ... + T[r]*P^(m-1))\n= P^l * (hash of the window)",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "ch16-03-prefix-hash-window-extraction-n3",
      "lineHeight": 1.25,
      "baseline": 15
    },
    {
      "id": "ch16-03-prefix-hash-window-extraction-n4",
      "type": "rectangle",
      "x": 200,
      "y": 400,
      "width": 960,
      "height": 90,
      "angle": 0,
      "strokeColor": "#0c8599",
      "backgroundColor": "#99e9f2",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 1504,
      "version": 1,
      "versionNonce": 1505,
      "isDeleted": false,
      "boundElements": [
        {
          "type": "text",
          "id": "ch16-03-prefix-hash-window-extraction-t4"
        }
      ],
      "updated": 1,
      "link": null,
      "locked": false
    },
    {
      "id": "ch16-03-prefix-hash-window-extraction-t4",
      "type": "text",
      "x": 206,
      "y": 435.0,
      "width": 948,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1704,
      "version": 1,
      "versionNonce": 1705,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Crucial Design Decision: Multiply, Never Divide!\n\u2022 Dividing window_raw by P^l causes precision loss and requires modular inverse.\n\u2022 Instead: multiply pattern hash by P^l (pw[l]):\n  winHash == (patHash * pw[l]) % MOD",
      "originalText": "Crucial Design Decision: Multiply, Never Divide!\n\u2022 Dividing window_raw by P^l causes precision loss and requires modular inverse.\n\u2022 Instead: multiply pattern hash by P^l (pw[l]):\n  winHash == (patHash * pw[l]) % MOD",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "ch16-03-prefix-hash-window-extraction-n4",
      "lineHeight": 1.25,
      "baseline": 15
    },
    {
      "id": "ch16-03-prefix-hash-window-extraction-n5",
      "type": "rectangle",
      "x": 330,
      "y": 515,
      "width": 700,
      "height": 65,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 1505,
      "version": 1,
      "versionNonce": 1506,
      "isDeleted": false,
      "boundElements": [
        {
          "type": "text",
