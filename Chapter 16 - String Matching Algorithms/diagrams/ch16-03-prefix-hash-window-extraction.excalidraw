    {
      "id": "ch16-03-prefix-hash-window-extraction-t1",
      "type": "text",
      "x": 146,
      "y": 180.0,
      "width": 468,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1701,
      "version": 1,
      "versionNonce": 1702,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "hs[r] = sum of val(T[k]) * P^k for k in 0..r\n(Cumulative weighted hash up to window end r)",
      "originalText": "hs[r] = sum of val(T[k]) * P^k for k in 0..r\n(Cumulative weighted hash up to window end r)",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "ch16-03-prefix-hash-window-extraction-n1",
      "lineHeight": 1.25,
      "baseline": 14
    },
