    {"id":"b1-theory-08-dijkstra-graph-38","type":"text","x":40,"y":491,"width":596,"height":18,"angle":0,"strokeColor":"#868e96","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":366,"version":1,"versionNonce":994,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"Final: A=0, B=2, D=7, E=8, F=9, C=12. Green edges = shortest path tree.","originalText":"Final: A=0, B=2, D=7, E=8, F=9, C=12. Green edges = shortest path tree.","fontSize":14,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"lineHeight":1.25,"baseline":14},
    {"id":"b1-theory-08-dijkstra-graph-39","type":"text","x":40,"y":515,"width":588,"height":18,"angle":0,"strokeColor":"#868e96","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":373,"version":1,"versionNonce":1007,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"Shortest path to C: A-B-D-F-C = 12. F also equals 9 via A-B-E-F (tie).","originalText":"Shortest path to C: A-B-D-F-C = 12. F also equals 9 via A-B-E-F (tie).","fontSize":14,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"lineHeight":1.25,"baseline":14},
