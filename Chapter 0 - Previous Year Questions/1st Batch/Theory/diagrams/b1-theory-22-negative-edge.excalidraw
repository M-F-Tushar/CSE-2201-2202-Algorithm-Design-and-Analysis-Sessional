      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Source A: B settles at 1 before C at 4\nLater C -> B gives 4 - 5 = -1; settled B is not revised\nTrue distances: A=0, C=4, B=-1; no cycle exists",
      "originalText": "Source A: B settles at 1 before C at 4\nLater C -> B gives 4 - 5 = -1; settled B is not revised\nTrue distances: A=0, C=4, B=-1; no cycle exists",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b1-theory-22-negative-edge-n3",
      "lineHeight": 1.25,
      "baseline": 15
    },
