    {"id":"b2-theory-07-kruskal-mst-32","type":"text","x":40,"y":386.25,"width":487.2,"height":17.5,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":8386,"version":1,"versionNonce":25159,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"Sorted edges: (1,5)=1, (1,4)=1, (2,1)=2, (3,2)=3, (3,1)=3,","originalText":"Sorted edges: (1,5)=1, (1,4)=1, (2,1)=2, (3,2)=3, (3,1)=3,","fontSize":14,"fontFamily":1,"textAlign":"left","verticalAlign":"middle","containerId":null,"lineHeight":1.25,"baseline":13,"autoResize":true},
    {"id":"b2-theory-07-kruskal-mst-33","type":"text","x":40,"y":410.25,"width":285.6,"height":17.5,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":8403,"version":1,"versionNonce":25210,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"(3,4)=5, (4,5)=6, (0,2)=7, (0,3)=9","originalText":"(3,4)=5, (4,5)=6, (0,2)=7, (0,3)=9","fontSize":14,"fontFamily":1,"textAlign":"left","verticalAlign":"middle","containerId":null,"lineHeight":1.25,"baseline":13,"autoResize":true},
    {"id":"b2-theory-07-kruskal-mst-34","type":"text","x":40,"y":434.25,"width":462,"height":17.5,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":8420,"version":1,"versionNonce":25261,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"1. Take (1,5), (1,4), (2,1), (3,2). None makes a cycle.","originalText":"1. Take (1,5), (1,4), (2,1), (3,2). None makes a cycle.","fontSize":14,"fontFamily":1,"textAlign":"left","verticalAlign":"middle","containerId":null,"lineHeight":1.25,"baseline":13,"autoResize":true},
    {"id":"b2-theory-07-kruskal-mst-35","type":"text","x":40,"y":458.25,"width":445.2,"height":17.5,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":8437,"version":1,"versionNonce":25312,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"2. Skip (3,1), (3,4), (4,5). Each one closes a cycle.","originalText":"2. Skip (3,1), (3,4), (4,5). Each one closes a cycle.","fontSize":14,"fontFamily":1,"textAlign":"left","verticalAlign":"middle","containerId":null,"lineHeight":1.25,"baseline":13,"autoResize":true},
    {"id":"b2-theory-07-kruskal-mst-36","type":"text","x":40,"y":482.25,"width":512.4,"height":17.5,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":8454,"version":1,"versionNonce":25363,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"3. Take (0,2). All 6 vertices are now connected with 5 edges.","originalText":"3. Take (0,2). All 6 vertices are now connected with 5 edges.","fontSize":14,"fontFamily":1,"textAlign":"left","verticalAlign":"middle","containerId":null,"lineHeight":1.25,"baseline":13,"autoResize":true},
    {"id":"b2-theory-07-kruskal-mst-37","type":"text","x":40,"y":505,"width":316.8,"height":20,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":8471,"version":1,"versionNonce":25414,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"MST cost = 1 + 1 + 2 + 3 + 7 = 14","originalText":"MST cost = 1 + 1 + 2 + 3 + 7 = 14","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"middle","containerId":null,"lineHeight":1.25,"baseline":14,"autoResize":true},
