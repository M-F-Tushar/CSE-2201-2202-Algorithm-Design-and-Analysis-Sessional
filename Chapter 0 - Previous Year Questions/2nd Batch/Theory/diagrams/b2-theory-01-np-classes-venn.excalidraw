    {"id":"b2-theory-01-np-classes-venn-8","type":"text","x":515.5,"y":226.25,"width":99,"height":37.5,"angle":0,"strokeColor":"#e8590c","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":4136,"version":1,"versionNonce":12409,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"NP-hard\n(not in NP)","originalText":"NP-hard\n(not in NP)","fontSize":15,"fontFamily":1,"textAlign":"center","verticalAlign":"middle","containerId":null,"lineHeight":1.25,"baseline":14,"autoResize":true},
    {"id":"b2-theory-01-np-classes-venn-9","type":"text","x":51.4,"y":391.25,"width":697.2,"height":17.5,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":4153,"version":1,"versionNonce":12460,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"P is inside NP. NP-complete = NP and NP-hard together (the hardest problems in NP).","originalText":"P is inside NP. NP-complete = NP and NP-hard together (the hardest problems in NP).","fontSize":14,"fontFamily":1,"textAlign":"center","verticalAlign":"middle","containerId":null,"lineHeight":1.25,"baseline":13,"autoResize":true},
    {"id":"b2-theory-01-np-classes-venn-10","type":"text","x":-3.2,"y":416.25,"width":806.4,"height":17.5,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":4170,"version":1,"versionNonce":12511,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"NP-hard problems need not be in NP (for example, optimization versions of NP-complete problems).","originalText":"NP-hard problems need not be in NP (for example, optimization versions of NP-complete problems).","fontSize":14,"fontFamily":1,"textAlign":"center","verticalAlign":"middle","containerId":null,"lineHeight":1.25,"baseline":13,"autoResize":true},
    {"id":"b2-theory-01-np-classes-venn-11","type":"text","x":34.6,"y":441.25,"width":730.8,"height":17.5,"angle":0,"strokeColor":"#868e96","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":4187,"version":1,"versionNonce":12562,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"Picture assumes P is not equal to NP (not proven), so P and NP-complete do not overlap.","originalText":"Picture assumes P is not equal to NP (not proven), so P and NP-complete do not overlap.","fontSize":14,"fontFamily":1,"textAlign":"center","verticalAlign":"middle","containerId":null,"lineHeight":1.25,"baseline":13,"autoResize":true}
