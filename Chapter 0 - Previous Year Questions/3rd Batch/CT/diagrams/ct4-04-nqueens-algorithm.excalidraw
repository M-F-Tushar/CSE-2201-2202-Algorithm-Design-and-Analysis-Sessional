      "versionNonce": 1705,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "q[row] = column\n\nrow 0 → 1\nrow 1 → 3\nrow 2 → 0\nrow 3 → 2\n\nreturn true",
      "originalText": "q[row] = column\n\nrow 0 → 1\nrow 1 → 3\nrow 2 → 0\nrow 3 → 2\n\nreturn true",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "ct4-04-nqueens-algorithm-n4",
      "lineHeight": 1.25,
      "baseline": 15
    },
