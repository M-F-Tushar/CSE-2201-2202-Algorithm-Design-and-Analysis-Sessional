      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Columns 0..3: [0,2] fails; [0,3,1] fails;\nthen [1,3,0,2] is the first solution.",
      "originalText": "Columns 0..3: [0,2] fails; [0,3,1] fails;\nthen [1,3,0,2] is the first solution.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "ct4-04-nqueens-algorithm-n3",
      "lineHeight": 1.25,
      "baseline": 14
    },
