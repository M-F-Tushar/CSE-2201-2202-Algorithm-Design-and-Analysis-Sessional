    {
      "id": "ct4-04-nqueens-algorithm-t4",
      "type": "text",
      "x": 856,
      "y": 357.5,
      "width": 208,
      "height": 150.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
