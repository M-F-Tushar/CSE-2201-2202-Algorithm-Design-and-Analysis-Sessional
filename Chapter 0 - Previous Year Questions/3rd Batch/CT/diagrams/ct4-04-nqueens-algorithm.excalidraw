      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Invariant: rows 0..row−1 already hold one mutually nonattacking queen; isSafe checks every attack direction above.\nWorst-case time O(n·n!); board storage Θ(n²), plus Θ(n) recursion-stack space.",
      "originalText": "Invariant: rows 0..row−1 already hold one mutually nonattacking queen; isSafe checks every attack direction above.\nWorst-case time O(n·n!); board storage Θ(n²), plus Θ(n) recursion-stack space.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "ct4-04-nqueens-algorithm-n6",
      "lineHeight": 1.25,
      "baseline": 14
    },
