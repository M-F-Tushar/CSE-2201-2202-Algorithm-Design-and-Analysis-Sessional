      "updated": 1,
      "link": null,
      "locked": false,
      "text": "2 locks in tail; 1 remains at A[0]. Array is FULLY SORTED!",
      "originalText": "2 locks in tail; 1 remains at A[0]. Array is FULLY SORTED!",
      "fontSize": 10,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "ch5-10-heap-sort-flow-n80",
