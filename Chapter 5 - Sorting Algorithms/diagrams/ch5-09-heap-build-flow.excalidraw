      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Complete Binary Tree Rules:\n\u2022 Left child = 2i + 1, Right = 2i + 2\n\u2022 Leaves: floor(n/2)..n-1 (already valid heaps)\n\u2022 Heapify internal nodes: floor(n/2) - 1 down to 0",
      "originalText": "Complete Binary Tree Rules:\n\u2022 Left child = 2i + 1, Right = 2i + 2\n\u2022 Leaves: floor(n/2)..n-1 (already valid heaps)\n\u2022 Heapify internal nodes: floor(n/2) - 1 down to 0",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "ch5-09-heap-build-flow-n0",
      "lineHeight": 1.25,
      "baseline": 11
