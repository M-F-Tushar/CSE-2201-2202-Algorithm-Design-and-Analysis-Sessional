      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Step 2: Partition Array\nTwo markers (i bound, j scan).\nSwap items <= pivot to left!\nFinally, swap pivot into i.\nPivot locks in final spot!",
      "originalText": "Step 2: Partition Array\nTwo markers (i bound, j scan).\nSwap items <= pivot to left!\nFinally, swap pivot into i.\nPivot locks in final spot!",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "ch5-08a-quick-sort-strategy-n2",
      "lineHeight": 1.25,
      "baseline": 12
    },
